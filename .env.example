# Supabase-Projekt "baseline-diagnostics" (Region eu-central-1).
# Der Publishable Key ist bewusst öffentlich — die Absicherung passiert über RLS.
VITE_SUPABASE_URL=https://bsbionvnsvqghaqijmpl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5HjIDmeWLD0lr1Gy9r4E8A_q-YHpSvE

# Zeigt das Dashboard mit Demodaten, solange keine Sitzung besteht.
VITE_DEMO_MODE=true

# Bezahlweg (Etappe 4). "on" erst, wenn Stripe eingerichtet ist — vorher
# gibt es keine Schranken, und die Preisseite sagt, dass nichts gekauft
# werden kann. Die Stripe-Schlüssel liegen NIE hier, sondern als Secrets
# der Edge Functions: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# STRIPE_PRICE_<PRODUKT>_<YEARLY|MONTHLY|ONCE>, optional STRIPE_AUTOMATIC_TAX.
VITE_BILLING=off

# Rennwetter im Reiter «Läufe» (Open-Meteo, nur auf Tipp des Nutzers).
# "on" erst nach Freigabe des Datenschutztextes (docs/rennwetter-datenschutz.md);
# der Prüfbau setzt es, die Auslieferung nicht.
VITE_RACE_WEATHER=on

# Check-ins dem Trainer zeigen (Umbau Etappe 3). "on" erst nach Freigabe des
# Datenschutztextes (docs/checkin-datenschutz.md) und nach Ausrollen der
# Migration 20261004100000_shared_checkins.sql; der Prüfbau setzt es.
VITE_CHECKIN_SHARE=on
# Sprachmodell-Umformulierung (Pro). Produktiv erst, wenn Anbieter, Region und AVV geklärt sind.
VITE_AI_PHRASE=on
# Trainingsplan: preview = Vorschau mit ungeprüften Regeln (nur für Entwicklung und Prüfläufe). Produktiv nie auf preview, solange Regeln ungeprüft sind.
VITE_TRAINING_PLAN=preview
VITE_PLAN_ASSIGN=on
