{
  "name": "baseline-diagnostics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Progressive Web App für periodische Sportdiagnostik, Leistungssimulation und White-Label-Reporting.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "db:types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "test": "playwright test",
    "test:phone": "playwright test --project=phone",
    "test:ui": "playwright test --ui",
    "mockups": "playwright test -c playwright.mockups.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "^2.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
