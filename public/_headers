# Sicherheits- und Cache-Regeln.
#
# Netlify liest diese Datei aus dem Publish-Verzeichnis — im Gegensatz zur
# netlify.toml gilt sie auch beim manuellen Deploy per Drag-and-drop.

/*
  # Verhindert MIME-Sniffing: ein als Bild ausgeliefertes Skript bleibt Bild.
  X-Content-Type-Options: nosniff
  # Kein Einbetten in fremde Seiten (Clickjacking).
  X-Frame-Options: DENY
  # Beim Verlassen der Seite nur die Herkunft senden, nie den vollen Pfad —
  # der könnte Athletenkennungen enthalten.
  Referrer-Policy: strict-origin-when-cross-origin
  # Gerätezugriffe nur für die eigene Seite und nur auf Tipp des Nutzers:
  # Bluetooth (Brustgurt), Kamera (Wiederholungen zählen, nur auf dem Gerät),
  # Mikrofon (Schlagzähler, Vorschau) und Standort (Lauf). Keine fremde Seite
  # bekommt sie, eingebettet wird ohnehin nicht.
  Permissions-Policy: accelerometer=(), bluetooth=(self), camera=(self), geolocation=(self), gyroscope=(), microphone=(self), payment=(), usb=()
  # HTTPS erzwingen, inklusive Subdomains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Ein von hier geoeffnetes Fenster bekommt keinen Griff auf dieses zurueck.
  # Betrifft auch das Umgekehrte: eine fremde Seite, die uns oeffnet, teilt
  # sich keine Browsergruppe mehr mit uns.
  Cross-Origin-Opener-Policy: same-origin
  # Unsere Dateien duerfen nicht von fremden Seiten eingebunden werden.
  Cross-Origin-Resource-Policy: same-origin
  # Content Security Policy. Die App lädt zur Laufzeit nichts von Dritten:
  # Schriften sind lokal gebündelt, Bilder liegen im Bundle.
  #
  # connect-src nennt genau diese fremden Herkünfte, jede beim Namen: das
  # Supabase-Projekt, Open Food Facts (Lebensmittelsuche, Schicht S4) und
  # Open-Meteo (Rennwetter im Reiter «Läufe», nur auf Tipp des Nutzers).
  # Kein Platzhalter, keine Wildcard über *.supabase.co — dann dürfte jedes
  # fremde Projekt angesprochen werden, und die Regel schützte nichts mehr.
  # Die wss-Zeile ist für die Echtzeitverbindung des Dienstes; ohne sie
  # bräche sie still ab.
  # 'unsafe-inline' bei style-src ist nötig, weil die Diagramme Stile inline
  # setzen; Skripte laufen ohne diese Ausnahme. 'wasm-unsafe-eval' erlaubt
  # nur, WebAssembly zu übersetzen (Kameraerkennung, von der eigenen
  # Herkunft) — kein eval() für Skripte.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://bsbionvnsvqghaqijmpl.supabase.co wss://bsbionvnsvqghaqijmpl.supabase.co https://world.openfoodfacts.org https://geocoding-api.open-meteo.com https://api.open-meteo.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
